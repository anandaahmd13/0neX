# 0neX - contoh environment. Salin ke .env (jangan commit .env asli).

# --- Personal AI Gateway (server/gateway-server.mjs) ---
# Satu listener melayani HTTP OpenAI-compatible + WebSocket Playground.
GATEWAY_WS_HOST=127.0.0.1
GATEWAY_WS_PORT=8788
ALLOWED_ORIGINS=http://localhost:5199,http://127.0.0.1:5199

# Public API: bootstrap/emergency key untuk /v1/*. Pemakaian sehari-hari
# sebaiknya memakai API key yang dibuat di dashboard (Gateway → API Keys),
# karena key dashboard bisa di-scope, di-expire, di-rotate, dan di-revoke
# per client. Key dashboard tersimpan sebagai hash di .data/gateway/api-keys.json.
# Bikin nilai acak: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GATEWAY_API_KEY=ganti-dengan-api-key-gateway-acak-panjang
# Admin API: dipakai skrip/CI pada /admin/* lewat Bearer token (server-to-server).
GATEWAY_ADMIN_TOKEN=ganti-dengan-admin-token-acak-panjang
# Password login dashboard. Ditukar jadi cookie sesi httpOnly di server.
# Kalau kosong, fallback ke GATEWAY_ADMIN_TOKEN.
GATEWAY_DASHBOARD_PASSWORD=ganti-dengan-password-dashboard
# WebSocket Playground. Credential provider tetap tersimpan server-side.
GATEWAY_TOKEN=ganti-dengan-ws-token-acak-panjang
# Minimal 16 karakter. Simpan stabil; menggantinya membuat provider key lama tak bisa didekripsi.
GATEWAY_MASTER_KEY=ganti-dengan-master-key-acak-minimal-32-karakter

# Storage server-side (connections terenkripsi + telemetry metadata JSONL).
GATEWAY_DATA_DIR=.data/gateway

# Rate limit token bucket per (API key + connection) di /v1/chat/completions.
# Kapasitas burst + laju refill per detik. Set 0 untuk menonaktifkan.
GATEWAY_RATE_CAPACITY=60
GATEWAY_RATE_REFILL_PER_SEC=1

# Tabel harga per model (USD per 1 juta token) untuk estimasi biaya di dashboard.
# Opsional; kalau tidak diisi, dipakai default + file .data/gateway/pricing.json.
# Format file: { "gpt-4o": { "input": 2.5, "output": 10 }, ... }
GATEWAY_PRICING_FILE=

# Alias model → target. Client bisa memanggil alias tanpa tahu connection.
# Target: "connection-id/upstream-model" (eksplisit) atau "upstream-model" (bare,
# gateway pilih connection yang mengeksposnya). GATEWAY_ALIASES = JSON inline,
# di-merge dengan file .data/gateway/aliases.json (file menang bila bentrok).
# Contoh: {"gpt-4o":"openrouter/openai/gpt-4o","fast":"groq/llama-3.1-8b-instant"}
GATEWAY_ALIASES=
GATEWAY_ALIASES_FILE=

# Batas resource Gateway.
GATEWAY_UPSTREAM_TIMEOUT_MS=120000
GATEWAY_MAX_BODY_BYTES=1000000
GATEWAY_RUN_TIMEOUT_MS=120000
GATEWAY_MAX_CLIENTS=4
GATEWAY_MAX_PROMPT_LEN=20000
GATEWAY_MAX_SYSTEM_PROMPT_LEN=12000
GATEWAY_MAX_OUTPUT_BYTES=2000000
GATEWAY_KILL_GRACE_MS=3000

# Claude CLI dijalankan di host gateway. Kiro punya dua surface:
#  - Kiro HTTPS inference (provider kiro-inference / alias kiro-cli) TIDAK butuh
#    binary; memakai credential connection terenkripsi yang dipilih di Playground.
#  - Kiro Agent (provider kiro-agent) menjalankan Kiro CLI lewat ACP untuk tools,
#    filesystem, terminal, dan MCP. Butuh binary Kiro CLI; kalau tidak ada,
#    provider agent dilaporkan unavailable dan inference HTTPS tetap jalan.
CLAUDE_CLI_COMMAND=claude
KIRO_CLI_COMMAND=kiro-cli

# Workspace root yang boleh diakses Kiro Agent (filesystem/terminal). Default cwd
# gateway. Browser hanya mengirim workspaceId; path absolut tidak pernah dari client.
# GATEWAY_KIRO_ACP_CWD=

# Batas waktu menunggu keputusan permission tool dari dashboard (ms).
GATEWAY_PERMISSION_TIMEOUT_MS=30000

# --- Frontend (Vite) ---
# Dashboard bicara same-origin: di dev lewat proxy Vite, di prod gateway menyajikan
# bundle. VITE_GATEWAY_HTTP_URL opsional — hanya untuk override target proxy dev.
# CATATAN: TIDAK ADA lagi VITE_GATEWAY_ADMIN_TOKEN. Admin token tidak boleh masuk
# bundle browser; dashboard pakai cookie sesi httpOnly dari /admin/login.
VITE_GATEWAY_HTTP_URL=http://localhost:8788
VITE_GATEWAY_WS_URL=ws://localhost:8788
VITE_GATEWAY_WS_TOKEN=ganti-dengan-ws-token-acak-panjang

# PERINGATAN: seluruh VITE_* tertanam di browser bundle. Jangan pernah menaruh
# admin token / API key di sana. Jangan expose /admin/* ke internet publik.
# Nama CLAUDE_BRIDGE_* dan VITE_CLAUDE_WS_* lama masih diterima sementara.
