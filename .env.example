# 0neX - contoh environment. Salin ke .env (jangan commit .env asli).

# --- Personal AI Gateway (server/gateway-server.mjs) ---
# Bind loopback adalah default aman. Jangan buka 0.0.0.0 tanpa auth/TLS tambahan.
GATEWAY_WS_HOST=127.0.0.1
GATEWAY_WS_PORT=8788
# Gunakan token acak panjang yang sama dengan VITE_GATEWAY_WS_TOKEN.
GATEWAY_TOKEN=ganti-dengan-token-acak-panjang
ALLOWED_ORIGINS=http://localhost:5199,http://127.0.0.1:5199

# Batas resource gateway lokal.
GATEWAY_RUN_TIMEOUT_MS=120000
GATEWAY_MAX_CLIENTS=4
GATEWAY_MAX_PROMPT_LEN=20000
GATEWAY_MAX_SYSTEM_PROMPT_LEN=12000
GATEWAY_MAX_OUTPUT_BYTES=2000000
GATEWAY_KILL_GRACE_MS=3000

# Provider Claude Code CLI. Default mencari perintah `claude` di PATH.
CLAUDE_CLI_COMMAND=claude

# --- Frontend (Vite) ---
VITE_GATEWAY_WS_URL=ws://localhost:8788
VITE_GATEWAY_WS_TOKEN=ganti-dengan-token-acak-panjang

# Nama CLAUDE_BRIDGE_* dan VITE_CLAUDE_WS_* lama masih diterima sementara
# untuk kompatibilitas konfigurasi PoC sebelumnya.
