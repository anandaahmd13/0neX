# 0neX — contoh environment. Salin ke .env (jangan commit .env asli).

# --- Claude Code bridge (server/claude-bridge.mjs) ---
# Port bridge WS.
WS_PORT=8788
# Host bind. Default 127.0.0.1 (loopback). JANGAN set 0.0.0.0 kecuali paham
# risikonya — bridge nge-spawn CLI, jadi kebuka ke jaringan = RCE.
WS_HOST=127.0.0.1
# Token wajib buat handshake. Kalau dikosongin, bridge auto-generate & print
# sekali saat start. Set nilai stabil di sini biar konsisten antar restart.
CLAUDE_BRIDGE_TOKEN=ganti-dengan-token-acak-panjang
# Origin yang diizinkan konek (CSV). Default sudah mencakup dev vite umum.
ALLOWED_ORIGINS=http://localhost:5199,http://127.0.0.1:5199
# Timeout run (ms) — proses claude yang lewat batas ini di-kill paksa.
CLAUDE_RUN_TIMEOUT_MS=120000
# Batas koneksi concurrent ke bridge.
CLAUDE_MAX_CLIENTS=4
# Batas panjang prompt (char) — payload lebih gede ditolak sebelum spawn.
CLAUDE_MAX_PROMPT_LEN=20000
# Jeda SIGTERM→SIGKILL (ms) saat menghentikan proses.
CLAUDE_KILL_GRACE_MS=3000

# --- Frontend (Vite, prefix VITE_) ---
# URL bridge yang dipakai UI. Harus cocok dgn WS_HOST/WS_PORT di atas.
VITE_CLAUDE_WS_URL=ws://localhost:8788
# Token yang sama dgn CLAUDE_BRIDGE_TOKEN — dipakai UI buat handshake.
VITE_CLAUDE_WS_TOKEN=ganti-dengan-token-acak-panjang
